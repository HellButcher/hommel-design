{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "motion": {
    "duration": {
      "$type": "duration",
      "interaction": { "$value": "{duration.0}" },
      "entrance": { "$value": "{duration.0}" }
    },
    "easing": {
      "$type": "cubicBezier",
      "interaction": { "$value": "{easing.100}" },
      "entrance": { "$value": "{easing.200}" }
    }
  }
}
