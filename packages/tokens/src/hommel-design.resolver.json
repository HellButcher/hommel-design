{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "Hommel Design System",
  "version": "2025.10",
  "resolutionOrder": [
    { "$ref": "#/sets/foundation" },
    { "$ref": "#/modifiers/theme" },
    { "$ref": "#/modifiers/density" },
    { "$ref": "#/modifiers/motion" },
    { "$ref": "#/sets/components" }
  ],
  "sets": {
    "foundation": {
      "sources": [
        { "$ref": "primitive/color.tokens.json" },
        { "$ref": "primitive/spacing.tokens.json" },
        { "$ref": "primitive/other.tokens.json" },
        { "$ref": "semantic/other.tokens.json" }
      ]
    },
    "components": {
      "sources": [
        { "$ref": "component/button.tokens.json" }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "description": "Color theme",
      "contexts": {
        "light": [
          { "$ref": "semantic/theme/light.tokens.json" }
        ],
        "dark": [
          { "$ref": "semantic/theme/dark.tokens.json" }
        ]
      },
      "default": "light"
    },
    "density": {
      "description": "Density setting",
      "contexts": {
        "calm": [{ "$ref": "semantic/density/calm.tokens.json" }],
        "compact": [{ "$ref": "semantic/density/compact.tokens.json" }]
      },
      "default": "calm"
    },
    "motion": {
      "description": "Animation/Transition settings",
      "contexts": {
        "normal": [{ "$ref": "semantic/motion/normal.tokens.json" }],
        "reduced": [{ "$ref": "semantic/motion/reduced.tokens.json" }]
      },
      "default": "normal"
    }
  }
}
