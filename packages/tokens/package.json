{
  "name": "@hommel/design-tokens",
  "version": "0.1.0",
  "type": "module",
	"main": "dist/index.css",
	"style": "dist/index.css",
	"sideEffects": [
    "dist/index.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.css",
