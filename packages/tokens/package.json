  "scripts": {
    "build": "tz build",
    "check": "tz check",
    "clear": "rm -rf dist"
  },
  "devDependencies": {
    "@terrazzo/cli": "^2.10.0",
    "@terrazzo/plugin-css": "^2.10.0",
    "@terrazzo/plugin-scss": "^2.10.0",
    "@terrazzo/token-tools": "^2.10.0",
    "@hommel/terrazzo-plugin-custom-css": "workspace:"
  }
