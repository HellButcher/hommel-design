    "./preview": "./dist/preview.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hommel/tokens-generator": "workspace:",
    "@hommel/tokens-tokenbook": "workspace:",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "11.0.0-beta.3",
    "@tsdown/css": "^0.23.7",
    "@types/react": "^18.0.0 || ^19.3.0",
    "tsdown": "^0.23.7",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@storybook/addon-docs": "^11.0.0-beta.3",
    "storybook": "^11.0.0-beta.3",
