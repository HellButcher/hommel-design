{
  "name": "@hommel/tokens-storybook",
  "version": "0.1.0",
  "description": "Components for displaying Design Tokens (DTCG 2025.10 incl. resolver)",
  "license": "MIT",
  "author": {
    "name": "Christoph Hommelsheim",
    "url": "https://hommel.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HellButcher/hommel-design"
  },
  "files": [
    "dist/",
    "manager.js",
    "preset.js",
    "preview.js"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/preview.mjs"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./blocks": "./dist/blocks.mjs",
    "./manager": "./dist/manager.mjs",
