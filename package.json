{
  "name": "hommel-design-project",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Christoph Hommelsheim",
    "url": "https://hommel.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HellButcher/hommel-design"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "pnpm run -r --if-present build",
    "test": "pnpm run -r --if-present test",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run -r --if-present check",
    "clean": "pnpm run -r --if-present clean",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "sync-package-json": "pnpm exec -r --include-workspace-root node \"$PWD/scripts/sync-package-json.ts\""
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d"
}
